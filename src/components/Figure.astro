---
import { Image } from 'astro:assets';
import { images } from '../lib/images';
import type { Figure } from '../lib/content-map';

interface Props { fig: Figure; widths?: number[]; sizes?: string; loading?: 'lazy' | 'eager' }
const { fig, widths = [480, 800, 1200], sizes = '(max-width: 900px) 100vw, 42vw', loading = 'lazy' } = Astro.props;
const src = images[fig.src];
if (!src) throw new Error(`Image not found: ${fig.src}`);
const classes = ['fig', fig.align ?? '', fig.format ?? ''].filter(Boolean).join(' ');
---
<figure class={classes + ' reveal'}>
  <Image src={src} alt={fig.alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={80} />
  {(fig.caption || fig.credit) && (
    <figcaption>
      {fig.caption}
      {fig.credit && <small>{fig.credit}</small>}
    </figcaption>
  )}
</figure>
